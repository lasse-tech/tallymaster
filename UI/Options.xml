<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <!-- Author/website/version block shown at the top of the options panel.
         Its own template so it gets its own frame pool and cannot inherit
         leftovers from a recycled Blizzard section header. -->
    <Frame name="TallymasterAboutTemplate" mixin="TallymasterAboutMixin" virtual="true">
        <Size y="45"/>
        <Layers>
            <Layer level="OVERLAY">
                <FontString parentKey="Text" inherits="GameFontHighlight" justifyH="LEFT" justifyV="TOP">
                    <Anchors>
                        <!-- x=7 matches SettingsListSectionHeaderTemplate's title -->
                        <Anchor point="TOPLEFT" x="7" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
    </Frame>
</Ui>
