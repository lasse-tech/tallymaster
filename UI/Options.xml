<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <!-- Author/website/version block shown at the top of the options panel.
         Its own template so it gets its own frame pool and cannot inherit
         leftovers from a recycled Blizzard section header. -->
    <Frame name="TallymasterAboutTemplate" mixin="TallymasterAboutMixin" virtual="true">
        <Size y="45"/>
        <Layers>
            <Layer level="OVERLAY">
                <FontString parentKey="Text" inherits="GameFontHighlight" justifyH="LEFT" justifyV="TOP">
                    <Anchors>
                        <!-- x=7 matches SettingsListSectionHeaderTemplate's title -->
                        <Anchor point="TOPLEFT" x="7" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <!-- "Made with <3 in Europe" chip below the text. Size and anchor are
                 set in Init, next to the extent they have to agree with. -->
            <Frame parentKey="Chip">
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture parentKey="Bg" setAllPoints="true">
                            <Color r="1" g="0.82" b="0" a="0.15"/>
                        </Texture>
                    </Layer>
                    <Layer level="OVERLAY">
                        <FontString parentKey="Label" inherits="GameFontNormalSmall" justifyH="CENTER">
                            <Anchors>
                                <Anchor point="CENTER"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>
        </Frames>
    </Frame>
</Ui>
