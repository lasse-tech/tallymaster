# NOTE: Interface 120000 targets WoW Midnight (12.0). Bump to the exact build
#       (e.g. 120000 -> 12000x) when the live patch number is known.

# Libraries (populated by the packager via .pkgmeta, or dropped in manually for local dev)
embeds.xml

# Localization
Locales\enUS.lua
Locales\deDE.lua

# Core
Core\Database.lua
Core\Core.lua
Core\Categories.lua
Core\Resolve.lua
Core\Counting.lua

# UI
UI\Tracker.lua
UI\AddInput.lua
UI\KnownList.lua
UI\Options.lua

# ElvUI integration (no-op if ElvUI absent)
Skin\ElvUI.lua

# NOTE: Bindings.xml is intentionally NOT listed here. WoW auto-loads a file named
# Bindings.xml from the addon root through its dedicated bindings loader. Listing it
# in the TOC instead routes it through the generic XML schema validator, which spams
# "Unrecognized XML: Binding" warnings (the <Binding> element isn't in that schema).
