# Third-party libraries are pulled at build time by the BigWigs/CurseForge
# packager (see .pkgmeta). They are not vendored in the repo; only the README
# documenting the expected layout is tracked.
/Libs/*
!/Libs/README.md

# Local editor / tooling state
/.claude/

# Build output (make dist)
/dist/

# Intermediate screenshot-cropping scratch files
/design/_crops/

# OS cruft
.DS_Store
Thumbs.db
